{
  "name": "socratic-tutor-server",
  "version": "0.2.0",
  "private": true,
  "description": "MCP server that serves reference solutions to the Socratic Tutor skill and logs student requests.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "dev": "tsc -p . && node dist/index.js",
    "load": "tsc -p . && node dist/load-solutions.js",
    "migrate": "tsc -p . && node dist/migrate.js",
    "test": "tsc -p . && node --test \"dist/test/*.test.js\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "express": "^5.1.0",
    "pg": "^8.13.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.9.3"
  }
}
